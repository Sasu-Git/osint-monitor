# /etc/osint/daemon.env (root:osint 0640). No API keys are needed: the pipeline runs without an LLM.
OSINT_DB_URL=sqlite:////opt/osint/data/live/window-2026-09-25.db
HF_HOME=/opt/osint/.cache/huggingface
# the embedding model is pinned by revision in the cache (refs/main); never fetch a newer one at start
HF_HUB_OFFLINE=1
